PORT=8080
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
MONITOR_REDIS_CHANNEL=monitoring:tasks
MONITOR_RESULTS_CHANNEL=monitoring:results
# With Laravel REDIS_PREFIX=laravel-database- use the full Redis key name:
# MONITOR_HEARTBEAT_KEY=laravel-database-go_monitor:last_heartbeat
MONITOR_HEARTBEAT_KEY=go_monitor:last_heartbeat

# Connectivity
INTERNET_CHECK_ENABLED=true
INTERNET_PROBE_URL=https://www.cloudflare.com
INTERNET_PROBE_TIMEOUT_SEC=5
INTERNET_OFFLINE_WAIT_SEC=10
REDIS_BRPOP_TIMEOUT_SEC=30
